{
  "name": "noteee",
  "short": "noteee",
  "description": "复古笔记本状态页主题：米黄格纸配墨绿墨水，卡片 / 列表双视图，硬件占用、流量、延迟、到期与费用一页尽览",
  "version": "1.0.0",
  "author": "bluesmkun",
  "url": "https://github.com/bluesmkun/noteee",
  "config": [
    {
      "type": "title",
      "label": "页面"
    },
    {
      "key": "notice",
      "type": "text",
      "label": "公告",
      "default": "",
      "help": "显示在页面顶部，留空不显示"
    },
    {
      "key": "layout",
      "type": "select",
      "label": "默认视图",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "卡片"
        },
        {
          "value": "list",
          "label": "列表"
        }
      ],
      "help": "访客自己切换过的，以访客的选择为准"
    },
    {
      "type": "title",
      "label": "护眼与排版"
    },
    {
      "key": "paper",
      "type": "select",
      "label": "纸张色调",
      "default": "cream",
      "options": [
        {
          "value": "cream",
          "label": "米黄（护眼）"
        },
        {
          "value": "mint",
          "label": "淡青格纸"
        },
        {
          "value": "kraft",
          "label": "牛皮纸"
        }
      ]
    },
    {
      "type": "title",
      "label": "显示内容"
    },
    {
      "key": "show_map",
      "type": "boolean",
      "label": "显示节点分布地图",
      "default": true
    },
    {
      "key": "show_latency",
      "type": "boolean",
      "label": "显示延迟色带",
      "default": true
    },
    {
      "key": "show_cost",
      "type": "boolean",
      "label": "显示费用",
      "default": true,
      "help": "关闭后卡片、列表与详情页都不再画金额"
    }
  ]
}
